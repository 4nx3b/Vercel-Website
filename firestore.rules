rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      // Same policy as /api/site-content: the signed-in admin account.
      // (Password accounts are unverified unless a verification link was clicked.)
      return request.auth != null
        && request.auth.token.email == "asaxxhiii@gmail.com";
    }

    match /amaQuestions/{questionId} {
      allow read: if isAdmin() || resource.data.answered == true;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          "id", "name", "question", "answer", "answered", "dismissed", "votes", "createdAt", "answeredAt"
        ])
        && request.resource.data.id == questionId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.question.size() <= 280
        && request.resource.data.answer == ""
        && request.resource.data.answered == false
        && request.resource.data.dismissed == false
        && request.resource.data.votes == 0
        && request.resource.data.createdAt is string
        && request.resource.data.answeredAt == null;

      allow update, delete: if isAdmin();
    }

    // Public visitors can read the published document; only the verified owner can write.
    // The Vercel publishing API uses its server account and does not depend on these rules.
    match /siteContent/{doc} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["json", "updatedAt"])
        && request.resource.data.json is string
        && request.resource.data.json.size() <= 900000
        && request.resource.data.updatedAt is string;
      allow delete: if isAdmin();
    }

    match /siteImages/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(["data", "createdAt"])
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 1000000
        && request.resource.data.createdAt is string;
      allow delete: if isAdmin();
    }

    // The profile is public so the same owner icon appears on every host.
    // Writes remain limited to the verified owner; the small allow-list keeps
    // the public document free of auth/session data.
    match /siteOwner/{doc} {
      allow read: if doc == "profile";
      allow create, update: if doc == "profile"
        && isAdmin()
        && request.resource.data.keys().hasOnly(["avatar", "updatedAt"])
        && request.resource.data.avatar is string
        && request.resource.data.avatar.size() <= 220000
        && (request.resource.data.avatar.size() == 0
          || request.resource.data.avatar.matches("^data:image/(webp|png|jpeg);base64,[A-Za-z0-9+/]+={0,2}$"))
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }
  }
}
